# Optional Compose overrides. Copy to `.env` at the repo root (gitignored).
# `docker compose` substitutes these into the frontend image build args.
# Leave this unused to keep the defaults below.
#
# These URLs are for a browser on the host, not Docker DNS names.
# The API key does not belong here. Put XAI_API_KEY in apps/agentservice/.env.

VITE_BACKEND_URL=http://127.0.0.1:3001
VITE_AGENTSERVICE_URL=http://127.0.0.1:3002
