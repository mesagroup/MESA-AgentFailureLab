# Copy to apps/agentservice/.env to override. Placeholders only — never commit a real key.
# Docker Compose loads this file when it exists and does not override XAI_API_KEY.
# Compose does set HOST=0.0.0.0, BACKEND_URL=http://mesa-backend:3001,
# and FRONTEND_URL=http://mesa-frontend:3000.
# This process has no shop base URL. The harness sends mock_base_url
# from MOCK_SHOP_URL (Compose http://mesa-mock-shop:8787, Render the public shop URL).

PORT=3002
HOST=127.0.0.1

# xAI / Grok. Leave the key empty in git. Set it only in this local .env or on Render.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Model name for POST /diagnose. Read at startup. The client does not hardcode it.
# The shop planner (agent: grok) always uses grok-4.6 with reasoning effort medium.
# It does not read GROK_MODEL. One attempt is 90s. The in-process attacker may try three times.
GROK_MODEL=grok-3
# Per-attempt timeout in milliseconds. A timeout or a retryable HTTP status is tried once more.
GROK_TIMEOUT_MS=30000
# Offline evalset proposals for local/CI. 1/true/yes skips the provider and never needs a key.
# Leave unset (or 0) in live so POST /evalset/generate calls Grok when XAI_API_KEY is set.
MESA_EVALSET_STUB=

# Public or loopback base URLs. Not secrets.
BACKEND_URL=http://127.0.0.1:3001
FRONTEND_URL=http://127.0.0.1:3000
