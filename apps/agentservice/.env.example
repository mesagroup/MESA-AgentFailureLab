# Copy to .env to override. Placeholders only — never commit a real key.
PORT=3002
HOST=127.0.0.1

# xAI / Grok. Leave the key empty in git. Set it only in a local .env or the host secret store.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Model name for POST /diagnose. Read at startup. The client does not hardcode it.
GROK_MODEL=grok-3
# Per-attempt timeout in milliseconds. A timeout or a retryable HTTP status is tried once more.
GROK_TIMEOUT_MS=30000
