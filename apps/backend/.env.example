# Copy to apps/backend/.env to override local `pnpm dev`. Git ignores .env.
# Docker and Render set HOST=0.0.0.0. Compose overrides the service URLs below
# with http://mesa-agentservice:3002 and http://mesa-frontend:3000.
# The shop is not in that stack, so MOCK_SHOP_URL stays the loopback default
# unless you point it at a shop you started yourself.

PORT=3001
HOST=127.0.0.1

# Inspectable shop. The harness reads GET /internal/state and calls tool routes.
# This is not the agent runtime (see the agent record's instance.base_url).
MOCK_SHOP_URL=http://127.0.0.1:8787

# Public or loopback base URLs. Not secrets.
AGENTSERVICE_URL=http://127.0.0.1:3002
FRONTEND_URL=http://127.0.0.1:3000

# Persistence is in-memory. Do not commit a real DATABASE_URL.
# DATABASE_URL=
