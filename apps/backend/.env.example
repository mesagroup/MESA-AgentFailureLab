# Copy to apps/backend/.env to override local `pnpm dev`. Git ignores .env.
# Docker and Render set HOST=0.0.0.0. Compose overrides the service URLs below
# with http://mesa-agentservice:3002, http://mesa-frontend:3000,
# http://mesa-mock-shop:8787, http://mesa-library-agent:3003, and
# http://mesa-mock-library:8788.
# FRONTEND_URL is the browser CORS allowlist (comma-separated http(s) origins).
# `*` is ignored. http://127.0.0.1:3000 and http://localhost:3000 are always
# allowed, because Vite and Compose serve the UI on port 3000. Compose's
# http://mesa-frontend:3000 name is not the Origin a browser sends.
# `pnpm dev` loads this file when it exists (`--env-file-if-exists=.env`).
# Leave the URLs below for a laptop. Compose and Render replace them.
# Start the shop with `pnpm dev:mock-shop` and the library pair with
# `pnpm --filter @mesa/mock-library dev` and `pnpm --filter @mesa/library-agent dev`.
# The agent service does not read MOCK_SHOP_URL. See docs/seed-endpoints.md.

# Optional stricter order_created (sku, qty, max_orders). Unset keeps today's check.
# STRICT_WORLD_CHECKS=1

PORT=3001
HOST=127.0.0.1

# Inspectable shop. The harness reads GET /internal/state and calls tool routes.
# Seeded onto reference-shop world.base_url. Shop runs still call this process value.
MOCK_SHOP_URL=http://127.0.0.1:8787

# Public or loopback base URLs. Not secrets.
# reference-shop instance and test_instance. The harness POSTs /v1/tasks/run.
AGENTSERVICE_URL=http://127.0.0.1:3002
# external-library instance and test_instance. The harness POSTs /v1/tasks/run.
LIBRARY_AGENT_URL=http://127.0.0.1:3003
# external-library world. Library runs call this origin.
MOCK_LIBRARY_URL=http://127.0.0.1:8788
# POST /traces/:traceId/diagnose calls AGENTSERVICE_URL, never an URL from the body.
# A blank AGENTSERVICE_URL disables new diagnosis calls (cached reads still work).
# The reference-shop seed then uses the laptop default for that origin.
# Whole upstream request + body timeout, 1..300000 ms; default 45000.
# Set above GROK_TIMEOUT_MS plus the provider-client retry budget.
DIAGNOSIS_TIMEOUT_MS=45000
# POST /evalset/generate proxies to AGENTSERVICE_URL. Same range as diagnosis (1..300000).
EVALSET_TIMEOUT_MS=45000
# Planner. Unset, or any value other than grok, keeps the scripted planner.
# grok asks the agent service for one Grok 4.6 tool-calling turn.
# The agent service calls xAI only when its own XAI_API_KEY is set.
# A missing key stays scripted and the UI shows "Scripted (no key)".
# Do not set these for CI or pnpm demo:shop --mode offline.
# JURY_AGENT=grok
# LAB_AGENT=grok
# ATTACKER_AGENT=grok
# FIX_AGENT=grok

# CORS allowlist for the browser. Comma-separated. Not `*`.
# Render: https://mesa-frontend-rleq.onrender.com
# Local dev and Compose already match the two port-3000 origins added in code.
FRONTEND_URL=http://127.0.0.1:3000

# Agent, run, and trace store. Leave unset for in-memory records
# (agents other than the reseeded reference-shop, and every run and trace, are lost on restart).
# Set a Postgres URL to keep them across restarts. Compose sets this itself.
# Do not commit a real DATABASE_URL.
# db:export, db:import, and db:reset read this file when the variable is blank in the shell.
# A shell value wins. The scripts do not print the URL. See docs/persistence.md.
# DATABASE_URL=postgres://mesa:mesa@127.0.0.1:5432/mesa
