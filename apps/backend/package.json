{
  "name": "@mesa/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic verifier, labeled fault injector, security attacker, and harness runner",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "jury-demo": "tsx src/attacker/cli.ts"
  },
  "dependencies": {
    "@mesa/shared": "workspace:*",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
