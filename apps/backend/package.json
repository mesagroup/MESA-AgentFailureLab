{
  "name": "@mesa/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic verifier, labeled fault injector, security attacker, and harness runner",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "jury-demo": "tsx src/attacker/cli.ts",
    "db:export": "tsx src/persistence/cli.ts export",
    "db:import": "tsx src/persistence/cli.ts import",
    "db:reset": "tsx src/persistence/cli.ts reset"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@mesa/shared": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
