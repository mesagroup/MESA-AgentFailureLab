# Copy to apps/frontend/.env for `pnpm dev` and a local `vite build`.
# Vite inlines VITE_ variables at build time. Only the VITE_ prefix is exposed.
# Docker Compose passes the same names as image build args (see the root .env.example).
# The running frontend container does not read this file.

VITE_BACKEND_URL=http://127.0.0.1:3001
VITE_AGENTSERVICE_URL=http://127.0.0.1:3002
