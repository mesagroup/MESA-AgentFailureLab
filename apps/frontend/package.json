{
  "name": "@mesa/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Web UI for agent registration, runs, and the trace timeline",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/lib/dashboard.test.ts src/lib/agents-page.test.ts src/lib/jury.test.ts src/lib/tasks.test.ts src/lib/otel.test.ts src/lib/evalset.test.ts src/lib/after-fix.test.ts src/lib/run-launch.test.ts",
    "preview": "vite preview --port 3000 --strictPort"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mesa/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
