{
  "name": "mesa-agent-failure-lab",
  "private": true,
  "version": "0.0.0",
  "description": "MESA Agent Failure Lab / CHAOS.AI — Track 03 monorepo",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:frontend": "turbo run dev --filter=@mesa/frontend",
    "dev:backend": "turbo run dev --filter=@mesa/backend",
    "dev:agentservice": "turbo run dev --filter=@mesa/agentservice",
    "dev:mock-shop": "turbo run dev --filter=@mesa/mock-shop"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
