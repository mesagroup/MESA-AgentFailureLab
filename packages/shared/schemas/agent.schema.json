{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mesagroup/MESA-AgentFailureLab/packages/shared/schemas/agent.schema.json",
  "title": "Agent",
  "description": "Registration record for an agent under test: where it runs, where its traces live, the docs the harness shows, and the tasks a deterministic verifier can score. This is not a Trace and not a Run. Each task carries its own setup and verifier checks, and may carry an optional evalset. The evalset is user-supplied material for a later Grok judgment of that task's Run or Trace. It is not a verifier check and it does not write outcome.verifier. The reference shop agent is seeded with five tasks (T1–T5). T1 includes one evalset case; T2–T5 omit the field. The library desk agent is seeded with three tasks that use library checks and omit evalset. Other agents may register a different non-empty task list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "description",
    "created_at",
    "updated_at",
    "instance",
    "test_instance",
    "traces",
    "docs",
    "tasks"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "instance": {
      "description": "Production or reference runtime. kind=reference is the in-repo shop agent. kind=external is a registrant-supplied endpoint. base_url is the agent runtime, not the mock shop.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_url", "runtime"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reference", "external"]
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "description": "Runtime name, for example grok."
        }
      }
    },
    "test_instance": {
      "description": "Isolated runtime used for replays. Separate from instance so a fix replay does not hit the production endpoint.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "runtime"],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "path_or_url"],
      "properties": {
        "store": {
          "type": "string",
          "enum": ["inline", "path", "url"]
        },
        "path_or_url": {
          "type": "string",
          "minLength": 1,
          "description": "Filesystem path, URL, or logical name when store is inline."
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_summary", "tools", "constraints", "config_notes"],
      "properties": {
        "prompt_summary": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "config_notes": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "world": {
      "description": "Inspectable mock for this agent. kind shop is the mock shop; kind library is the library mock. base_url is the mock, not the agent runtime. The harness calls MOCK_SHOP_URL for a shop world and world.base_url for a library world.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_url"],
      "properties": {
        "kind": { "enum": ["shop", "library"] },
        "base_url": { "type": "string", "format": "uri" }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "prompt", "setup", "success_test"],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "description": "World the harness builds before the agent runs, and the permissions granted on the agent request. Cart lines are added first. Each order then checks out that cart. permissions is the agent grant, not the header used to seed the shop.",
          "type": "object",
          "additionalProperties": false,
          "required": ["cart", "orders", "permissions"],
          "properties": {
            "cart": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sku", "qty"],
                "properties": {
                  "sku": {
                    "type": "string",
                    "minLength": 1
                  },
                  "qty": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "orders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from_cart"],
                "properties": {
                  "from_cart": {
                    "description": "Check out the cart seeded above. The shop assigns the order id.",
                    "const": true
                  }
                }
              }
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["read", "write:cart", "write:order", "write:order:cancel", "write:loan", "write:hold"]
              }
            },
            "library": {
              "description": "Loans the harness seeds on the library mock before the agent runs. Shop tasks omit this. Cart and orders stay empty.",
              "type": "object",
              "additionalProperties": false,
              "required": ["loans"],
              "properties": {
                "loans": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["loan_id", "book_id", "patron_id", "renewals"],
                    "properties": {
                      "loan_id": { "type": "string", "minLength": 1 },
                      "book_id": { "type": "string", "minLength": 1 },
                      "patron_id": { "type": "string", "minLength": 1 },
                      "renewals": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        },
        "success_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "checks"],
          "properties": {
            "type": {
              "description": "Only verifier_checks in this freeze. The verifier reads mock state; it does not score the agent's prose.",
              "const": "verifier_checks"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "description"],
                "properties": {
                  "name": {
                    "description": "Registered check type. Params are validated against that type's schema.",
                    "type": "string",
                    "enum": [
                      "catalog_read",
                      "product_viewed",
                      "cart_contains",
                      "cart_empty",
                      "order_created",
                      "order_total_matches",
                      "order_status_read",
                      "cancel_respects_permission",
                      "loan_renewed",
                      "loan_returned",
                      "hold_placed"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "object",
                    "description": "Arguments for this check type. Required keys depend on name. Unknown keys are rejected."
                  }
                }
              }
            }
          }
        },
        "evalset": {
          "description": "Optional user-supplied material a later Grok judgment may read when looking at a Run or Trace for this task. Omit the field when the task has none. version 1 with cases: [] is valid and means no cases yet. The deterministic verifier does not read this object. Pass/fail stays on success_test, scored from mock world state. This object never writes outcome.verifier. version is the shape of this object; only 1 is valid.",
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "cases"],
          "properties": {
            "version": {
              "description": "Evalset document shape. Only 1 is valid in this contract. A consumer that does not know the version must reject the document.",
              "const": 1
            },
            "cases": {
              "description": "Judge cases for this task. Order is the author's order. An empty array is valid.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["case_id", "expectation"],
                "properties": {
                  "case_id": {
                    "description": "Stable id within this task's evalset. Unique among cases on the same task.",
                    "type": "string",
                    "minLength": 1
                  },
                  "expectation": {
                    "description": "What the judge should look for in the Trace or Run (claims, steps, tool use). Not a world-state assertion. Those stay on success_test.checks.",
                    "type": "string",
                    "minLength": 1
                  },
                  "rubric": {
                    "description": "How the judge should score the expectation. Free text. Optional. Does not write outcome.verifier.",
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
