{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mesagroup/MESA-AgentFailureLab/packages/shared/schemas/agent.schema.json",
  "title": "Agent",
  "description": "Registration record for an agent under test: where it runs, where its traces live, the docs the harness shows, and the tasks a deterministic verifier can score. This is not a Trace and not a Run. The reference shop agent carries five tasks (T1–T5); other agents may register a different non-empty task list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "description",
    "created_at",
    "updated_at",
    "instance",
    "test_instance",
    "traces",
    "docs",
    "tasks"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "instance": {
      "description": "Production or reference runtime. kind=reference is the in-repo shop agent. kind=external is a registrant-supplied endpoint. base_url is the agent runtime, not the mock shop.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_url", "runtime"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reference", "external"]
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "description": "Runtime name, for example grok."
        }
      }
    },
    "test_instance": {
      "description": "Isolated runtime used for replays. Separate from instance so a fix replay does not hit the production endpoint.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "runtime"],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "path_or_url"],
      "properties": {
        "store": {
          "type": "string",
          "enum": ["inline", "path", "url"]
        },
        "path_or_url": {
          "type": "string",
          "minLength": 1,
          "description": "Filesystem path, URL, or logical name when store is inline."
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_summary", "tools", "constraints", "config_notes"],
      "properties": {
        "prompt_summary": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "config_notes": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "prompt", "success_test"],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "success_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "checks"],
          "properties": {
            "type": {
              "description": "Only verifier_checks in this freeze. The verifier reads mock state; it does not score the agent's prose.",
              "const": "verifier_checks"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "description"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "object",
                    "description": "Optional machine-readable arguments for the check, such as sku and qty. The verifier is not implemented in this package."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
