{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mesagroup/MESA-AgentFailureLab/packages/shared/schemas/agent.schema.json",
  "title": "Agent",
  "description": "Registration record for an agent under test: where it runs, where its traces live, the docs the harness shows, and the tasks a deterministic verifier can score. This is not a Trace and not a Run. Each task carries its own setup and verifier checks. The reference shop agent is seeded with five tasks (T1–T5). The library desk agent is seeded with three tasks that use library checks. Other agents may register a different non-empty task list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "description",
    "created_at",
    "updated_at",
    "instance",
    "test_instance",
    "traces",
    "docs",
    "tasks"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "instance": {
      "description": "Production or reference runtime. kind=reference is the in-repo shop agent. kind=external is a registrant-supplied endpoint. base_url is the agent runtime, not the mock shop.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_url", "runtime"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reference", "external"]
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "description": "Runtime name, for example grok."
        }
      }
    },
    "test_instance": {
      "description": "Isolated runtime used for replays. Separate from instance so a fix replay does not hit the production endpoint.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "runtime"],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "path_or_url"],
      "properties": {
        "store": {
          "type": "string",
          "enum": ["inline", "path", "url"]
        },
        "path_or_url": {
          "type": "string",
          "minLength": 1,
          "description": "Filesystem path, URL, or logical name when store is inline."
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_summary", "tools", "constraints", "config_notes"],
      "properties": {
        "prompt_summary": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "config_notes": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "world": {
      "description": "Inspectable mock for this agent. Omitted on the shop seed, which uses MOCK_SHOP_URL. base_url is the mock, not the agent runtime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_url"],
      "properties": {
        "kind": { "const": "library" },
        "base_url": { "type": "string", "format": "uri" }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "prompt", "setup", "success_test"],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "description": "World the harness builds before the agent runs, and the permissions granted on the agent request. Cart lines are added first. Each order then checks out that cart. permissions is the agent grant, not the header used to seed the shop.",
          "type": "object",
          "additionalProperties": false,
          "required": ["cart", "orders", "permissions"],
          "properties": {
            "cart": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sku", "qty"],
                "properties": {
                  "sku": {
                    "type": "string",
                    "minLength": 1
                  },
                  "qty": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "orders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from_cart"],
                "properties": {
                  "from_cart": {
                    "description": "Check out the cart seeded above. The shop assigns the order id.",
                    "const": true
                  }
                }
              }
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["read", "write:cart", "write:order", "write:order:cancel", "write:loan", "write:hold"]
              }
            },
            "library": {
              "description": "Loans the harness seeds on the library mock before the agent runs. Shop tasks omit this. Cart and orders stay empty.",
              "type": "object",
              "additionalProperties": false,
              "required": ["loans"],
              "properties": {
                "loans": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["loan_id", "book_id", "patron_id", "renewals"],
                    "properties": {
                      "loan_id": { "type": "string", "minLength": 1 },
                      "book_id": { "type": "string", "minLength": 1 },
                      "patron_id": { "type": "string", "minLength": 1 },
                      "renewals": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        },
        "success_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "checks"],
          "properties": {
            "type": {
              "description": "Only verifier_checks in this freeze. The verifier reads mock state; it does not score the agent's prose.",
              "const": "verifier_checks"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "description"],
                "properties": {
                  "name": {
                    "description": "Registered check type. Params are validated against that type's schema.",
                    "type": "string",
                    "enum": [
                      "catalog_read",
                      "product_viewed",
                      "cart_contains",
                      "cart_empty",
                      "order_created",
                      "order_total_matches",
                      "order_status_read",
                      "cancel_respects_permission",
                      "loan_renewed",
                      "loan_returned",
                      "hold_placed"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "object",
                    "description": "Arguments for this check type. Required keys depend on name. Unknown keys are rejected."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
