{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesa:agent-failure-lab:trace",
  "title": "Trace",
  "description": "One agent attempt at one task. Success is outcome.verifier only. Grok may write diagnosis and must not write outcome.verifier or fault (injected, labels, attacker). Harness phase, injection plan, and fix application live on Run, not on Trace. JSON Schema is the source of truth; OpenAPI is not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "agent_id",
    "run_id",
    "task_id",
    "started_at",
    "ended_at",
    "status",
    "steps",
    "outcome",
    "totals",
    "fault",
    "diagnosis"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Harness Run this trace belongs to. Run metadata is not embedded here."
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Null while status is running."
    },
    "status": {
      "$ref": "#/$defs/TraceStatus",
      "description": "Execution lifecycle only. Task success is outcome.verifier.passed."
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier"],
      "properties": {
        "verifier": {
          "description": "Sole success authority. Written only by the deterministic verifier from task checks and mock state. Grok must not write this object.",
          "$ref": "#/$defs/VerifierOutcome"
        }
      }
    },
    "totals": {
      "$ref": "#/$defs/Totals"
    },
    "fault": {
      "description": "Ground truth for chaos runs. Written only by the injector/attacker. Grok must not write injected, labels, or attacker.",
      "$ref": "#/$defs/Fault"
    },
    "diagnosis": {
      "description": "Null until Grok fills it. The only Trace region Grok may write.",
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/Diagnosis" }
      ]
    }
  },
  "$defs": {
    "TraceStatus": {
      "type": "string",
      "enum": ["running", "completed", "error", "cancelled"]
    },
    "FaultCategory": {
      "type": "string",
      "enum": [
        "Plan",
        "ToolUse",
        "Context",
        "Reasoning",
        "Execution",
        "Verification",
        "Security"
      ]
    },
    "StepType": {
      "type": "string",
      "enum": ["message", "tool_call", "tool_result", "system"]
    },
    "StepRole": {
      "type": "string",
      "enum": ["user", "assistant", "tool", "system"]
    },
    "JsonValue": {
      "description": "Any JSON value.",
      "anyOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/JsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/JsonValue" } }
      ]
    },
    "TokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "index", "type", "timestamp", "role", "content"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based order within the trace. Unique among steps."
        },
        "type": { "$ref": "#/$defs/StepType" },
        "timestamp": { "type": "string", "format": "date-time" },
        "role": { "$ref": "#/$defs/StepRole" },
        "content": { "type": "string" },
        "tool_name": { "type": ["string", "null"] },
        "tool_call_id": { "type": ["string", "null"] },
        "tool_input": { "$ref": "#/$defs/JsonValue" },
        "tool_output": { "$ref": "#/$defs/JsonValue" },
        "tool_error": {
          "type": ["string", "null"],
          "description": "Tool failure text. Null when the tool call succeeded or the step is not a tool."
        },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "token_usage": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/TokenUsage" }]
        },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "VerifierCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "passed", "message"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": ["string", "null"] }
      }
    },
    "VerifierOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks", "mock_state_snapshot"],
      "properties": {
        "passed": {
          "type": "boolean",
          "description": "True only when every check passed against mock state."
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/VerifierCheckResult" }
        },
        "mock_state_snapshot": {
          "type": "object",
          "description": "World state read from the mock e-commerce API at verification time. The verifier does not score narrative trace text.",
          "additionalProperties": true
        }
      }
    },
    "Totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "tokens", "cost_usd"],
      "properties": {
        "latency_ms": { "type": "number", "minimum": 0 },
        "tokens": { "$ref": "#/$defs/TokenUsage" },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "FaultLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/FaultCategory" },
        "step_id": {
          "type": ["string", "null"],
          "description": "Step the injector attributes this label to, when known."
        },
        "detail": { "type": "string" }
      }
    },
    "Fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injected", "labels", "attacker"],
      "properties": {
        "injected": { "type": "boolean" },
        "labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/FaultLabel" }
        },
        "attacker": {
          "type": ["string", "null"],
          "description": "Injector/attacker identity for a chaos run. Null when nothing was injected."
        }
      }
    },
    "DiagnosisEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "note"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "ProposedFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fix_id", "summary"],
      "properties": {
        "fix_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    },
    "Diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Grok hypothesis. category is not ground truth; compare it to fault.labels. A proposed fix counts only after harness replay and the verifier.",
      "required": [
        "category",
        "cause",
        "step_id",
        "confidence",
        "evidence",
        "proposed_fixes"
      ],
      "properties": {
        "category": { "$ref": "#/$defs/FaultCategory" },
        "cause": { "type": "string" },
        "step_id": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/DiagnosisEvidence" }
        },
        "proposed_fixes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProposedFix" }
        }
      }
    }
  }
}
