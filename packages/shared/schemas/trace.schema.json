{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mesagroup/MESA-AgentFailureLab/packages/shared/schemas/trace.schema.json",
  "title": "Trace",
  "description": "One observed attempt of an agent on a single task. This document is not a Run: phase (baseline|injected|after_fix), injection_plan, and fix_kinds belong only to run.schema.json. outcome.verifier is the only pass/fail authority and is computed from mock state by the deterministic verifier; outcome.success must equal outcome.verifier.passed and is written only by that verifier. fault.labels are written only by the injector or the attacker. diagnosis is null until Grok runs, and Grok must never write outcome.verifier. Per-step latency_ms, token_usage, and cost_usd are required, as are totals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "agent_id",
    "run_id",
    "task_id",
    "started_at",
    "ended_at",
    "status",
    "steps",
    "outcome",
    "totals",
    "fault",
    "diagnosis"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the Run that produced this trace. The Run itself is a separate document."
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "$ref": "#/$defs/traceStatus"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "fault": {
      "$ref": "#/$defs/fault"
    },
    "diagnosis": {
      "description": "null until the Grok diagnosis service writes it. Grok must not write outcome.verifier.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/diagnosis"
        }
      ]
    }
  },
  "$defs": {
    "traceStatus": {
      "description": "completed: the attempt finished and outcome.verifier.passed is true. failed: the attempt finished and the verifier did not pass. timeout: the harness stopped on a time limit. error: the attempt stopped on a runtime or harness error.",
      "type": "string",
      "enum": ["completed", "failed", "timeout", "error"]
    },
    "faultCategory": {
      "description": "Closed set shared with Run.ground_truth and Diagnosis. ToolUse is the schema spelling of 'Tool use'.",
      "type": "string",
      "enum": [
        "Plan",
        "ToolUse",
        "Context",
        "Reasoning",
        "Execution",
        "Verification",
        "Security"
      ]
    },
    "fixKind": {
      "description": "Fix proposed on a Diagnosis or applied on a Run. Application state lives on the Run (fix_kinds), not on the Trace. controlled_retry retries a failed tool at most twice; pre_response_check forces a read-back before a success claim; permission_guard blocks write:order:cancel without that permission.",
      "type": "string",
      "enum": ["controlled_retry", "pre_response_check", "permission_guard"]
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "step": {
      "description": "Universal keys are always required. content is required for message and system. tool_name plus tool_input are required for tool_call. tool_name plus tool_output are required for tool_result. Other tool/content keys may be omitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "index",
        "type",
        "timestamp",
        "role",
        "latency_ms",
        "token_usage",
        "cost_usd"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based position in steps. Producers should keep indexes dense and unique."
        },
        "type": {
          "type": "string",
          "enum": ["message", "tool_call", "tool_result", "system"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "tool", "system"]
        },
        "content": {
          "type": "string"
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "tool_input": {
          "description": "Arguments sent to the tool. Any JSON value."
        },
        "tool_output": {
          "description": "Value returned by the tool, or a forged value when a fault rewrote the result. Any JSON value."
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "token_usage": {
          "$ref": "#/$defs/tokenUsage"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "message"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["content"],
            "properties": {
              "content": {
                "type": "string"
              },
              "role": {
                "enum": ["user", "assistant"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool_call"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["tool_name", "tool_input"],
            "properties": {
              "role": {
                "const": "assistant"
              },
              "tool_name": {
                "type": "string",
                "minLength": 1
              },
              "tool_input": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool_result"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["tool_name", "tool_output"],
            "properties": {
              "role": {
                "const": "tool"
              },
              "tool_name": {
                "type": "string",
                "minLength": 1
              },
              "tool_output": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "system"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["content"],
            "properties": {
              "content": {
                "type": "string"
              },
              "role": {
                "const": "system"
              }
            }
          }
        }
      ]
    },
    "verifierCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "verifier", "agent_claimed_success"],
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Must equal verifier.passed. Written only by the deterministic verifier, never by the agent or by Grok."
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "description": "Sole pass/fail truth. Derived from mock state, not from the agent's claim and not from Grok.",
          "required": ["passed", "checks", "mock_state_snapshot"],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/verifierCheck"
              }
            },
            "mock_state_snapshot": {
              "type": "object",
              "description": "JSON snapshot the verifier judged. For the reference shop this is the body of GET /internal/state (carts, orders, inventory, observations)."
            }
          }
        },
        "agent_claimed_success": {
          "type": "boolean",
          "description": "What the agent asserted. Independent of verifier.passed; a mismatch is a verification failure signal, not a second verdict."
        }
      }
    },
    "totals": {
      "description": "Required rollup of the attempt. Producers should set these to the sums of the step fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "tokens_in", "tokens_out", "cost_usd"],
      "properties": {
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "faultLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "step_id", "code"],
      "properties": {
        "category": {
          "$ref": "#/$defs/faultCategory"
        },
        "step_id": {
          "type": "string",
          "minLength": 1,
          "description": "Step the injector or attacker attributes the fault to."
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Stable machine code from the injector or attacker, for example forged_tool_result. Not a closed enum."
        }
      }
    },
    "fault": {
      "description": "Labels are written only by the injector or the attacker. A clean attempt has injected false, no labels, and attacker.used false.",
      "type": "object",
      "additionalProperties": false,
      "required": ["injected", "labels", "attacker"],
      "properties": {
        "injected": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/faultLabel"
          }
        },
        "attacker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "payload_id"],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "payload_id": {
              "description": "Identifier of the malicious payload when attacker.used is true; null otherwise.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "injected": {
                "const": true
              }
            },
            "required": ["injected"]
          },
          "then": {
            "properties": {
              "labels": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "injected": {
                "const": false
              }
            },
            "required": ["injected"]
          },
          "then": {
            "properties": {
              "labels": {
                "type": "array",
                "maxItems": 0
              },
              "attacker": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "boolean",
                    "const": false
                  },
                  "payload_id": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attacker": {
                "type": "object",
                "required": ["used"],
                "properties": {
                  "used": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            },
            "required": ["attacker"]
          },
          "then": {
            "properties": {
              "injected": {
                "const": true
              },
              "attacker": {
                "type": "object",
                "required": ["payload_id"],
                "properties": {
                  "payload_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attacker": {
                "type": "object",
                "required": ["used"],
                "properties": {
                  "used": {
                    "type": "boolean",
                    "const": false
                  }
                }
              }
            },
            "required": ["attacker"]
          },
          "then": {
            "properties": {
              "attacker": {
                "type": "object",
                "required": ["payload_id"],
                "properties": {
                  "payload_id": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "diagnosis": {
      "description": "Structured output of the Grok diagnosis service. step_id is the culprit step (AI spec: culprit_step_id). proposed_fixes names FixKind values; applying them is recorded on the Run, not here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "cause",
        "step_id",
        "confidence",
        "evidence",
        "proposed_fixes"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/faultCategory"
        },
        "cause": {
          "type": "string",
          "minLength": 1,
          "description": "One or two sentences on the failure mechanism, not only the symptom."
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_fixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fixKind"
          }
        }
      }
    }
  }
}
